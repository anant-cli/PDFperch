# Content Security Policy Directives
# - script-src 'unsafe-inline': required for the inline onload="" handlers used
#   on preloaded stylesheets/scripts across pages, and for JSON-LD blocks
# - script-src blob:: required by loadModuleWithIntegrity() in utils.js, which
#   verifies a module's hash before importing it from a same-origin Blob URL
#   (used for the pptx-preview dependency that can't carry an SRI attribute)
# - cdn.jsdelivr.net, cdnjs.cloudflare.com: loads critical WebAssembly and JavaScript libraries (e.g. pdf-lib, KaTeX, Mammoth)
# - worker-src blob:: required for pdf.js and Tesseract.js web workers running client-side

/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' blob: cdn.jsdelivr.net cdnjs.cloudflare.com esm.sh unpkg.com; worker-src 'self' blob: cdn.jsdelivr.net cdnjs.cloudflare.com esm.sh unpkg.com; style-src 'self' 'unsafe-inline' cdn.jsdelivr.net cdnjs.cloudflare.com fonts.googleapis.com; img-src 'self' data: blob:; font-src 'self' cdn.jsdelivr.net cdnjs.cloudflare.com fonts.gstatic.com; connect-src 'self' cdn.jsdelivr.net cdnjs.cloudflare.com esm.sh unpkg.com; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

/sw.js
  Cache-Control: no-cache

# These are only ever referenced with a ?v=<build-id> query string, stamped
# by scripts/bump-cache.js on every deploy (see package.json "build" script).
# Because the URL changes on every deploy, it's safe to cache the response
# for a full year: a stale cached copy can never be served under the new
# deploy's HTML, since the HTML points at a different URL entirely.
/styles.css
  Cache-Control: public, max-age=31536000, immutable
/utils.js
  Cache-Control: public, max-age=31536000, immutable
/components.js
  Cache-Control: public, max-age=31536000, immutable
/script.js
  Cache-Control: public, max-age=31536000, immutable
/tools/*
  Cache-Control: public, max-age=31536000, immutable

# Icons/screenshots change rarely and aren't versioned, so a shorter cache
# with revalidation is the safer default for these.
/*.png
  Cache-Control: public, max-age=604800, must-revalidate
/*.ico
  Cache-Control: public, max-age=604800, must-revalidate

/llms.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=86400

# Defensive-only: this project deploys via Cloudflare's GitHub integration,
# which never uploads .git in the first place. This rule just makes sure
# nothing is ever served from that path even if the deploy method changes
# in the future (e.g. a one-off direct/Wrangler upload of the working copy).
/.git/*
  X-Robots-Tag: noindex
  Cache-Control: no-store

/robots.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600
