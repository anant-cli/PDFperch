# Content Security Policy Directives
# PDFperch is fully static and client-side: user files are processed in the
# browser and never uploaded. Every library and font is self-hosted under
# /vendor, so the policy allows NO third-party origins at all.
# - script-src 'unsafe-inline': inline theme bootstrap, JSON-LD blocks and the
#   onload="" handlers on preloaded stylesheets
# - script-src 'wasm-unsafe-eval': lets Tesseract.js compile its WebAssembly
#   OCR core (it does NOT allow JavaScript eval)
# - connect-src 'self': OCR language models are fetched from /vendor
# - img-src/frame-src blob: and data:: in-browser previews of the user's own files
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; worker-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; object-src 'none'; frame-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

/sw.js
  Cache-Control: no-cache

# These are only ever referenced with a ?v=<build-id> query string, stamped
# by scripts/bump-cache.js on every deploy (see package.json "build" script).
# Because the URL changes on every deploy, it's safe to cache the response
# for a full year: a stale cached copy can never be served under the new
# deploy's HTML, since the HTML points at a different URL entirely.
/styles.css
  Cache-Control: public, max-age=31536000, immutable
/utils.js
  Cache-Control: public, max-age=31536000, immutable
/components.js
  Cache-Control: public, max-age=31536000, immutable
/script.js
  Cache-Control: public, max-age=31536000, immutable
/tools/*
  Cache-Control: public, max-age=31536000, immutable

# Self-hosted libraries. Paths are not versioned, so cache for a day and
# revalidate in the background rather than marking them immutable.
/vendor/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Icons/screenshots change rarely and aren't versioned, so a shorter cache
# with revalidation is the safer default for these.
/*.png
  Cache-Control: public, max-age=604800, must-revalidate
/*.ico
  Cache-Control: public, max-age=604800, must-revalidate

/llms.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=86400

# Defensive-only: this project deploys via Cloudflare's GitHub integration,
# which never uploads .git in the first place. This rule just makes sure
# nothing is ever served from that path even if the deploy method changes
# in the future (e.g. a one-off direct/Wrangler upload of the working copy).
/.git/*
  X-Robots-Tag: noindex
  Cache-Control: no-store

/robots.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600
